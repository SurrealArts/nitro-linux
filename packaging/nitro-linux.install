_install_config() {
  if [ ! -e /etc/nitro.conf ]; then
    install -Dm644 /usr/share/nitro-linux/nitro.conf /etc/nitro.conf
  fi
}

_check_source_install() {
  if [ -e /usr/local/bin/nitrod ] ||
     [ -e /usr/local/bin/nitro-linux ] ||
     [ -e /etc/systemd/system/nitrod.service ]; then
    echo ":: WARNING: a source install appears to be present."
    echo ":: Remove it with deploy/uninstall.sh before using the package."
  fi
}

_invoking_user() {
  local u sid uid users=
  for u in "${SUDO_USER:-}" "$(logname 2>/dev/null || true)"; do
    if [ -n "$u" ] && [ "$u" != root ] && id "$u" >/dev/null 2>&1; then
      printf '%s\n' "$u"
      return 0
    fi
  done
  command -v loginctl >/dev/null 2>&1 || return 1
  for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '$1 ~ /^[0-9]+$/ {print $1}'); do
    [ "$(loginctl show-session "$sid" -p Class --value 2>/dev/null)" = user ] || continue
    [ "$(loginctl show-session "$sid" -p Remote --value 2>/dev/null)" = no ] || continue
    [ "$(loginctl show-session "$sid" -p Active --value 2>/dev/null)" = yes ] || continue
    uid="$(loginctl show-session "$sid" -p User --value 2>/dev/null)"
    [ -n "$uid" ] || continue
    u="$(id -nu "$uid" 2>/dev/null)" || continue
    [ "$u" != root ] || continue
    case " $users " in
      *" $u "*) ;;
      *) users="$users $u" ;;
    esac
  done
  users="${users# }"
  [ -n "$users" ] || return 1
  case "$users" in
    *" "*) return 1 ;;
  esac
  printf '%s\n' "$users"
}

_run_as_user() {
  local u="$1"; shift
  if command -v runuser >/dev/null 2>&1; then
    runuser -u "$u" -- "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo -u "$u" -- "$@"
  else
    return 1
  fi
}

_ensure_nitro_group() {
  getent group nitro >/dev/null 2>&1 || groupadd -r nitro
}

_tighten_state() {
  install -d -m755 -o root -g root /var/lib/nitro
  chmod 755 /var/lib/nitro 2>/dev/null || true
  chmod 600 /var/lib/nitro/state.json /var/lib/nitro/history.db 2>/dev/null || true
  rm -f /var/lib/nitro/state.json.tmp 2>/dev/null || true
}

_add_user_nitro() {
  local u
  _ensure_nitro_group
  if ! u="$(_invoking_user)"; then
    echo ":: Add your desktop user to group nitro, then log out and back in:"
    echo "::   sudo usermod -aG nitro \"\$USER\""
    return 0
  fi
  if id -nG "$u" | grep -qw nitro; then
    return 0
  fi
  usermod -aG nitro "$u"
  echo ":: Added $u to group nitro. Log out and back in so the TUI can connect."
}

_auto_key() {
  local u uid home
  if ! u="$(_invoking_user)"; then
    echo ":: Run 'nitro key auto' as your desktop user to bind the Nitro key."
    return 0
  fi
  uid="$(id -u "$u")"
  home="$(getent passwd "$u" | cut -d: -f6)"
  if [ -z "$home" ]; then
    echo ":: Run 'nitro key auto' as $u to bind the Nitro key."
    return 0
  fi
  if [ -e "$home/.config/nitro/key.json" ]; then
    echo ":: Nitro key: already configured; run 'nitro key auto' as $u to refresh the listener."
    return 0
  fi
  echo ":: Nitro key: configuring for $u"
  if _run_as_user "$u" env \
      HOME="$home" \
      XDG_RUNTIME_DIR="/run/user/$uid" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
      /usr/bin/nitro key auto --if-unconfigured; then
    return 0
  fi
  echo ":: Nitro key: setup incomplete; run 'nitro key auto' as $u to finish."
}

_disable_key() {
  local u uid home
  if ! u="$(_invoking_user)"; then
    return 0
  fi
  uid="$(id -u "$u")"
  home="$(getent passwd "$u" | cut -d: -f6)"
  [ -n "$home" ] || return 0
  rm -f "$home/.config/systemd/user/default.target.wants/nitro-key.service"
  rm -f "$home/.config/autostart/nitro-key.desktop"
  if [ -d "/run/user/$uid" ] && [ -S "/run/user/$uid/bus" ]; then
    _run_as_user "$u" env HOME="$home" XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" systemctl --user disable --now nitro-key.service >/dev/null 2>&1 || true
  fi
}

post_install() {
  _install_config
  _check_source_install
  _tighten_state
  _add_user_nitro
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/nitro-linux.conf >/dev/null 2>&1 || true
    systemctl enable nitro-apply.service nitrod.service
  fi
  echo ":: Reboot once to load the nitro kernel module."
  _auto_key
}

post_upgrade() {
  _install_config
  _tighten_state
  _add_user_nitro
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/nitro-linux.conf >/dev/null 2>&1 || true
    systemctl enable nitro-apply.service nitrod.service
    systemctl try-restart nitro-apply.service 2>/dev/null || true
    systemctl try-restart nitrod.service 2>/dev/null || true
  fi
  _auto_key
}

pre_remove() {
  _disable_key
  if [ -d /run/systemd/system ]; then
    systemctl disable --now nitrod.service nitro-apply.service 2>/dev/null || true
  fi
}

post_remove() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
  fi
  echo ":: /etc/nitro.conf, /var/lib/nitro, and the user Nitro key config were kept."
}
