[Unit]
Description=nitro daemon (keyboard effects, thermal polling)
After=systemd-modules-load.service nitro-apply.service
ConditionPathExists=/sys/devices/platform/nitro

[Service]
Type=simple
ExecStart=/usr/local/bin/nitrod
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
