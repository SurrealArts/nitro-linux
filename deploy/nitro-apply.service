[Unit]
Description=Apply /etc/nitro.conf (Acer Nitro)
After=systemd-modules-load.service
ConditionPathExists=/sys/devices/platform/nitro

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nitro-apply
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
